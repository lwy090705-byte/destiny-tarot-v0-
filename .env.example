# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Pi Network authentication
# Set to "true" when testing outside Pi Browser (sandbox mode)
NEXT_PUBLIC_PI_SANDBOX=false

# Server-side session signing secret (required in production)
PI_SESSION_SECRET=

# Optional share invite base URL
# NEXT_PUBLIC_SHARE_INVITE_BASE=https://www.destiny-tarot.kr/share
